{
  "name": "ai-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec air-jam-server dev",
    "topology": "pnpm exec air-jam-server topology",
    "secure:init": "pnpm exec air-jam-server secure:init",
    "status": "pnpm exec air-jam-server status",
    "reset:local": "pnpm exec air-jam-server reset local",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "mcp": "pnpm exec airjam-mcp",
    "tunnel:ui": ".bin\\cloudflared.exe tunnel --url http://localhost:5173",
    "tunnel:server": ".bin\\cloudflared.exe tunnel --url http://localhost:4000"
  },
  "dependencies": {
    "@air-jam/sdk": "^0.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@air-jam/mcp-server": "^0.9.2",
    "@air-jam/server": "^0.9.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
